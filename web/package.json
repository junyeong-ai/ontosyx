{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:a11y": "pnpm build && playwright test tests/e2e/a11y.spec.ts",
    "test:a11y:no-build": "playwright test tests/e2e/a11y.spec.ts",
    "i18n-audit": "node scripts/i18n-audit.mjs --typed",
    "i18n-parity-audit": "node scripts/i18n-parity-audit.mjs",
    "i18n-dotted-key-audit": "node scripts/i18n-dotted-key-audit.mjs",
    "error-code-parity-audit": "node scripts/error-code-parity-audit.mjs",
    "heading-primitive-audit": "node scripts/heading-primitive-audit.mjs",
    "ui-drift-audit": "node scripts/ui-drift-audit.mjs",
    "contrast-audit": "node scripts/contrast-audit.mjs",
    "use-client-audit": "node scripts/use-client-audit.mjs",
    "source-size-audit": "node scripts/source-size-audit.mjs",
    "design-rules-audit": "node scripts/design-rules-audit.mjs",
    "lighthouse": "lhci autorun",
    "gate": "pnpm typecheck && pnpm lint && pnpm i18n-audit && pnpm i18n-parity-audit && pnpm i18n-dotted-key-audit && pnpm error-code-parity-audit && pnpm heading-primitive-audit && pnpm ui-drift-audit && pnpm contrast-audit && pnpm use-client-audit && pnpm source-size-audit && pnpm design-rules-audit && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:e2e:no-build": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/react-grid-layout": "^1.3.6",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "focus-trap-react": "^12.0.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-force-graph-2d": "^1.29.1",
    "react-grid-layout": "^2.2.3",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@biomejs/biome": "^2.4.14",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
