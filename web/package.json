{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:a11y": "pnpm build && playwright test tests/e2e/a11y.spec.ts",
    "test:a11y:no-build": "playwright test tests/e2e/a11y.spec.ts",
    "i18n-audit": "node scripts/i18n-audit.mjs --typed",
    "i18n-parity-audit": "node scripts/i18n-parity-audit.mjs",
    "i18n-dotted-key-audit": "node scripts/i18n-dotted-key-audit.mjs",
    "error-code-parity-audit": "node scripts/error-code-parity-audit.mjs",
    "api-error-envelope-audit": "node scripts/api-error-envelope-audit.mjs",
    "platform-port-parity-audit": "node ../scripts/platform-port-parity.mjs",
    "source-feature-parity-audit": "node ../scripts/source-feature-parity.mjs",
    "heading-primitive-audit": "node scripts/heading-primitive-audit.mjs",
    "ui-drift-audit": "node scripts/ui-drift-audit.mjs",
    "contrast-audit": "node scripts/contrast-audit.mjs",
    "use-client-audit": "node scripts/use-client-audit.mjs",
    "source-size-audit": "node scripts/source-size-audit.mjs",
    "design-rules-audit": "node scripts/design-rules-audit.mjs",
    "lighthouse": "lhci autorun",
    "gate": "pnpm typecheck && pnpm lint && pnpm i18n-audit && pnpm i18n-parity-audit && pnpm i18n-dotted-key-audit && pnpm error-code-parity-audit && pnpm api-error-envelope-audit && pnpm platform-port-parity-audit && pnpm source-feature-parity-audit && pnpm heading-primitive-audit && pnpm ui-drift-audit && pnpm contrast-audit && pnpm use-client-audit && pnpm source-size-audit && pnpm design-rules-audit && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:e2e:no-build": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "focus-trap-react": "^12.0.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.5",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-grid-layout": "^2.2.4",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
